<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Umkreissuche: Fine bevorzugt, Coarse reicht als Fallback (Android 12+). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- usesCleartextTraffic nur fuer lokale Entwicklung (http://10.0.2.2:8080); fuer Release entfernen. -->
    <application
        android:name=".ChargeShareApplication"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="true"
        android:label="ChargeShare"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.ChargeShare">
        <!-- Noetig fuer Google Pay im Stripe-PaymentSheet (Google-Pay-API aktivieren). -->
        <meta-data
            android:name="com.google.android.gms.wallet.api.enabled"
            android:value="true" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.ChargeShare.Starting"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density|fontScale|layoutDirection|locale">
            <!-- Kein Neustart der Activity bei Drehen & Co.: ein offenes Zahlungsfenster haengt an dieser Activity-Instanz,
                 Compose passt sich Konfigurationsaenderungen selbst an. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Rückkehr vom Stripe-Onboarding: chargeshare://onboarding-done bzw. chargeshare://onboarding-refresh;
                 außerdem der Link aus der „Passwort vergessen“-Mail: chargeshare://reset-password?token=…
                 singleTask: die laufende Activity wird nach vorn geholt und bekommt den Link per onNewIntent. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="chargeshare" android:host="onboarding-done" />
                <data android:scheme="chargeshare" android:host="onboarding-refresh" />
                <data android:scheme="chargeshare" android:host="reset-password" />
            </intent-filter>
        </activity>
        <!-- Gibt Quittungs-PDFs aus dem App-Cache an die im Teilen-Dialog gewählte App weiter. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
