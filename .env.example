# Konfiguration fuer :server (Umgebungsvariablen, gleiche Namen wie im Go-Backend)
DATABASE_URL=postgres://chargeshare:chargeshare@localhost:5432/chargeshare
JWT_SECRET=change-me-at-least-32-characters-long-secret
JWT_REFRESH_SECRET=change-me-too-another-long-secret-value
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PLATFORM_FEE_PERCENT=15
# Oeffentlicher Stripe-Schluessel, wird per GET /api/v1/payments/config an die Apps ausgeliefert (nie sk_...!)
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Apple Pay (nur iOS): Merchant-ID aus dem Apple-Developer-Konto
APPLE_PAY_MERCHANT_ID=merchant.app.chargeshare
# Google Pay: test | production (Standard: abgeleitet aus dem Publishable Key, pk_live_ = production)
GOOGLE_PAY_ENVIRONMENT=test
# Haendlerdaten in den Zahlungsdialogen
MERCHANT_DISPLAY_NAME=ChargeShare
MERCHANT_COUNTRY_CODE=DE
APPLE_BUNDLE_ID=app.chargeshare
PORT=8080
ENV=development
# Dev: Beispieldaten (Bremen) beim Start anlegen; nur wirksam bei ENV=development
DEV_SEED=true
# Ohne STRIPE_SECRET_KEY nutzt der Server im Dev-Modus einen Fake-Payment-Provider (Buchungen sofort bezahlt)
# APPLE_BUNDLE_ID muss fuer POST /auth/apple gesetzt sein (sonst 501)
